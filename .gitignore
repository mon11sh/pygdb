cache/

# Build artifacts
build/
target/
out/

# ================================================================
# DOCKER BUILD FILES (Keep — needed to build the images; no secrets)
# ================================================================
!.dockerignore
!.env.docker

# ================================================================
# RENDER DEPLOYMENT (Keep these files)
# ================================================================
# Keep deployment configuration files
!render.yaml
!requirements.txt
!package.json
!Dockerfile
!.env.example
# NOTE: .env.production is intentionally NOT un-ignored — production config must
# be injected at deploy time (secrets manager / K8s Secrets), never committed.
# (Enterprise remediation H-2.)

# ================================================================
# COMMENTS
# ================================================================
# This .gitignore file is designed for the GDB Banking Application
# It excludes sensitive files, build artifacts, and temporary files
# while preserving necessary configuration and deployment files
#
# Key principles:
# 1. Never commit secrets or sensitive data
# 2. Exclude build artifacts and dependencies
# 3. Keep deployment configuration files
# 4. Exclude IDE and OS-specific files
# 5. Exclude logs and temporary files
#
# To add exceptions, use the ! prefix:
# !important-file.txt
#
# To ignore files in specific directories only:
# /specific-directory/*.log