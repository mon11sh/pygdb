# ================================================================
# GDB Accounts Service - Environment Configuration
# ================================================================

# Environment Mode: 'development' or 'production'
ENVIRONMENT=development
DEBUG=True

# Application Info
APP_NAME=GDB-Accounts-Service
PORT=8001

# ================================================================
# DATABASE PROVIDER — switch databases by changing ONLY these values
# Supported: sqlite | mysql | postgres | supabase | inmemory
# Same source, five databases.
# ================================================================
DATABASE_PROVIDER=postgres
# Optional explicit SQLAlchemy URL. Leave EMPTY to auto-build from the
# DATABASE_* fields below. Examples per provider:
#   sqlite   -> DATABASE_PROVIDER=sqlite     (uses ./gdb_accounts.db, no server)
#   mysql    -> DATABASE_PROVIDER=mysql       DATABASE_URL=mysql+aiomysql://user:pass@localhost:3306/gdb_accounts_db
#   postgres -> DATABASE_PROVIDER=postgres    (auto-built from DATABASE_* below, or paste a postgresql:// URL)
#   supabase -> DATABASE_PROVIDER=supabase    DATABASE_URL=postgresql://postgres:pass@db.<ref>.supabase.co:5432/postgres
#   inmemory -> DATABASE_PROVIDER=inmemory    (no server, no persistence)
# NOTE: a non-empty DATABASE_URL always wins — clear it to use sqlite/inmemory.
DATABASE_URL=

# Database Settings (used to auto-build the URL for postgres/supabase/mysql)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=gdb_accounts_db
DATABASE_USER=postgres
DATABASE_PASSWORD=password

# Security Secrets (CHANGE THESE IN PRODUCTION)
# ----------------------------------------------------------------
# Key for PIN encryption logic
PIN_ENCRYPTION_KEY=dev-pin-encryption-key-12345
# Secret for JWT validation (MUST MATCH AUTH SERVICE)
JWT_SECRET_KEY=dev-jwt-secret-key-do-not-use-in-prod
JWT_ALGORITHM=HS256

# Inter-Service URLs (Update if services move to different hosts/ports)
# ----------------------------------------------------------------
ACCOUNTS_SERVICE_URL=http://localhost:8001
TRANSACTIONS_SERVICE_URL=http://localhost:8002
USERS_SERVICE_URL=http://localhost:8003
AUTH_SERVICE_URL=http://localhost:8004
AADHAR_SERVICE_URL=http://localhost:8005
COMPANY_SERVICE_URL=http://localhost:8006
NOTIFICATION_SERVICE_URL=http://localhost:8007
PAYMENT_GATEWAY_SERVICE_URL=http://localhost:8008

# Logging
LOG_LEVEL=INFO
